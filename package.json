{
  "name": "zenlecs",
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev:launcher": "vite --config launcher/vite.config.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --packages=external --format=esm --outdir=dist-electron && esbuild electron/preload.ts --bundle --platform=node --external:electron --packages=external --format=cjs --outfile=dist-electron/preload.cjs && vite build --config launcher/vite.config.ts --base=./ && vite build --config app/vite.config.ts --base=./ && electron-builder",
    "dev": "concurrently \"npm run dev:launcher\" \"npm run dev:app\" \"esbuild electron/main.ts --bundle --platform=node --external:electron --packages=external --format=esm --outdir=dist-electron && esbuild electron/preload.ts --bundle --platform=node --external:electron --packages=external --format=cjs --outfile=dist-electron/preload.cjs && wait-on tcp:127.0.0.1:5173 tcp:127.0.0.1:5174 && electron .\"",
    "pack:app": "node script/pack-app.mjs",
    "build:launcher": "node script/build-launcher.mjs",
    "build": "tsx script/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
